# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (Supabase PostgreSQL) ---
# Option A (recommended): one URL. URL-encode special characters in the password (@ -> %40, # -> %23)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Option B: separate variables (used only when DATABASE_URL is empty)
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Supabase requires SSL
DB_SSLMODE=require
# Persistent connection lifetime in seconds. Forced to 0 for the transaction pooler (port 6543).
DB_CONN_MAX_AGE=60

# --- JWT ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
